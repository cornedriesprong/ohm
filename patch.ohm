bpm = 180

hit = |k n| bres k n * (1 - clock * n % 1) ^ 3

kick = |k n| 
  env = (hit k n) ^ 3
  pm (env * 120) (lfo * 0.15) * env

hat = |k n|
  env = (hit k n) ^ 3 -> lp1 0.5
  noise (lfo * 0.15) * env -> bp 500

mod = lfo * 500 + 500
n1 = <Cm Gm7> -> voice mod
a = n1 * hit 5 8 * 0.5
b = kick 3 8
c = hat 7 16 * 0.2

bus1 = a * 0.4 -> rev
bus2 = a * 0.5 -> bbd 0.5 0.9

{a b c bus1 bus2} -> mix
